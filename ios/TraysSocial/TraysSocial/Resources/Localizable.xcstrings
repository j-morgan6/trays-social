    "Recipes are user-submitted. We don't verify ingredients, allergens, or food safety — cook at your own risk.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipes are user-submitted. We don't verify ingredients, allergens, or food safety — cook at your own risk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les recettes sont soumises par les utilisateurs. Nous ne vérifions ni les ingrédients, ni les allergènes, ni la sécurité alimentaire — cuisinez à vos propres risques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las recetas las envían los usuarios. No verificamos los ingredientes, los alérgenos ni la seguridad alimentaria; cocina bajo tu propia responsabilidad."
          }
        }
      }
    },
