    "fallback": "No title left means the fallback",
    "abbreviation": "A period after one of the abbreviations, in any case, never ends the title",
    "no_tradeoff": "The known cost of treating no as an abbreviation",
    "initial": "A period after a single-letter initial never ends the title",
    "dotted_initial": "A word of single letters each followed by a period keeps its last period mid-line, so a.m. never ends a sentence",
    "not_dotted_initial": "A word with a run of two or more letters is not a dotted initial",
    "number": "A period followed by anything but whitespace never ends the title",
    "whitespace": "Each whitespace character after a period ends the sentence",
    "not_whitespace": "Zero-width characters, and a space carrying a combining mark, are not whitespace"
