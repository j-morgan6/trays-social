<%!-- Magic-link confirm, in the WebAuth split panel (W252) so the whole
     sign-in flow shares one shell. Amber primary, surface secondary. --%>

<.auth_shell id="confirm-sign-in">
  <.auth_heading title={"Welcome, #{@user.email}"}>
    {if @user.confirmed_at,
      do: "Pick how long you want to stay logged in.",
      else: "Confirm to finish setting up your tray."}
  </.auth_heading>

  <.auth_status :if={Phoenix.Flash.get(@flash, :info)} class="mt-6">
    {Phoenix.Flash.get(@flash, :info)}
  </.auth_status>

  <.callout :if={Phoenix.Flash.get(@flash, :error)} id="confirm-error" class="mt-6">
    {Phoenix.Flash.get(@flash, :error)}
  </.callout>

  <.form
    :if={!@user.confirmed_at}
    for={@form}
    id="confirmation_form"
    action={~p"/users/log-in?_action=confirmed"}
    class="mt-6 flex flex-col gap-3"
  >
    <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
    <.accent_button
      type="submit"
      wide
      name={@form[:remember_me].name}
      value="true"
      phx-disable-with="Confirming…"
      class="min-h-[52px] text-base shadow-lg shadow-accent/30"
    >
      Confirm and stay signed in
    </.accent_button>
    <.secondary_button type="submit" wide phx-disable-with="Confirming…">
      Confirm just this once
    </.secondary_button>
  </.form>

  <.form
    :if={@user.confirmed_at}
    for={@form}
    id="login_form"
    action={~p"/users/log-in"}
    class="mt-6 flex flex-col gap-3"
  >
    <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
    <%= if @current_scope do %>
      <.accent_button
        type="submit"
        wide
        phx-disable-with="Logging in…"
        class="min-h-[52px] text-base shadow-lg shadow-accent/30"
      >
        Log in
      </.accent_button>
    <% else %>
      <.accent_button
        type="submit"
        wide
        name={@form[:remember_me].name}
        value="true"
        phx-disable-with="Logging in…"
        class="min-h-[52px] text-base shadow-lg shadow-accent/30"
      >
        Keep me signed in on this browser
      </.accent_button>
      <.secondary_button type="submit" wide phx-disable-with="Logging in…">
        Log in just this once
      </.secondary_button>
    <% end %>
  </.form>

  <p :if={!@user.confirmed_at} class="mt-6 text-center text-[13px] leading-normal text-muted">
    Prefer a password? You can set one in your account settings.
  </p>
</.auth_shell>
