<%!-- Log in, per the WebAuth artboard (W252): the brand panel does the
     Welcome screen's job beside the form. Continue with Apple first, then
     email and password, "Keep me logged in" and the amber Log in button,
     with the amber callout directly above it. Flashes render here rather
     than as toasts (the controller sets :inline_flash). There is no
     password reset on the web, so "Forgot password?" reveals the existing
     sign-in link form. Sudo mode (@current_scope) reuses the page to
     reauthenticate. --%>

<.auth_shell id="log-in">
  <%= if @current_scope do %>
    <.auth_heading
      title="Reauthenticate"
      subtitle="Confirm your password to perform sensitive actions on your account."
    />
  <% else %>
    <.auth_heading title="Welcome back" subtitle="Log in to get back to your tray." />
  <% end %>

  <.auth_status :if={Phoenix.Flash.get(@flash, :info)} class="mt-6">
    {Phoenix.Flash.get(@flash, :info)}
  </.auth_status>

  <div
    :if={local_mail_adapter?()}
    class="mt-6 flex items-start gap-2.5 rounded-[14px] bg-base-100 px-3.5 py-3 text-[13.5px] leading-[1.45] text-muted ring-1 ring-inset ring-hairline-strong"
  >
    <.icon name="hero-information-circle" class="mt-px size-5 shrink-0" />
    <span>
      You're on the local mail adapter: sent emails appear in <.link
        href="/dev/mailbox"
        class="font-semibold text-primary-ink underline"
      >the mailbox</.link>.
    </span>
  </div>

  <div class="mt-6 flex flex-col gap-4">
    <.apple_button />
    <.or_divider />

    <.form
      :let={f}
      for={@form}
      as={:user}
      id="login_form_password"
      action={~p"/users/log-in"}
      class="flex flex-col gap-4"
    >
      <.auth_input
        field={f[:email]}
        type="email"
        label="Email"
        autocomplete="email"
        placeholder="you@example.com"
        readonly={!!@current_scope}
        required
      />
      <.auth_input
        field={f[:password]}
        type="password"
        label="Password"
        autocomplete="current-password"
        placeholder="Your password"
        required
      >
        <:aside>
          <a
            href="#sign-in-link"
            class="-my-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary-ink hover:underline"
          >
            Forgot password?
          </a>
        </:aside>
      </.auth_input>

      <.auth_checkbox
        field={f[:remember_me]}
        label="Keep me logged in on this browser"
        default
      />

      <.callout :if={Phoenix.Flash.get(@flash, :error)} id="login-error">
        {Phoenix.Flash.get(@flash, :error)}
      </.callout>

      <.accent_button
        type="submit"
        wide
        phx-disable-with="Logging in…"
        class="min-h-[52px] text-base shadow-lg shadow-accent/30"
      >
        Log in
      </.accent_button>
    </.form>
  </div>

  <%!-- No reset flow exists on the web; the sign-in link is the way back
       in. The section is hidden until "Forgot password?" targets it
       (:target), so it opens without JavaScript in every browser. --%>
  <section
    id="sign-in-link"
    aria-labelledby="sign-in-link-title"
    class="mt-6 hidden scroll-mt-24 rounded-[18px] bg-base-100 p-4 ring-1 ring-inset ring-hairline-strong target:block"
  >
    <div class="flex items-start justify-between gap-3">
      <h2
        id="sign-in-link-title"
        class="font-display text-[17px] font-extrabold text-base-content"
      >
        Email me a sign-in link
      </h2>
      <a
        href="#log-in"
        class="-mt-2 -mr-2 inline-flex size-11 shrink-0 items-center justify-center rounded-full text-muted hover:text-base-content"
        aria-label="Close the sign-in link form"
      >
        <.icon name="hero-x-mark" class="size-5" />
      </a>
    </div>
    <p class="mt-1 text-[14px] leading-[1.45] text-muted">
      Enter the email you signed up with and we'll send a link that logs you in.
    </p>
    <.form
      :let={f}
      for={@form}
      as={:user}
      id="login_form_magic"
      action={~p"/users/log-in"}
      class="mt-4 flex flex-col gap-4"
    >
      <.auth_input field={f[:email]} type="email" label="Email" autocomplete="email" required />
      <.secondary_button type="submit" wide phx-disable-with="Sending…">
        Send sign-in link
      </.secondary_button>
    </.form>
  </section>

  <p :if={!@current_scope} class="mt-[22px] text-center text-[15px] text-muted">
    New here?
    <.link
      navigate={~p"/users/register"}
      class="inline-flex min-h-11 items-center px-1 font-semibold text-primary-ink hover:underline"
    >
      Create an account
    </.link>
  </p>
</.auth_shell>
