<%!-- Public marketing landing page (W120). Rendered by PageController.home
     for anonymous visitors; authenticated visitors are redirected to their
     signed-in home. Renders inside the root layout, so the site header (with
     Log in / Sign up) and flash group are already present above this content.

     Two versions (W218): with recipe_first on, the page describes Home,
     Search and My Tray in the redesign's type and components; with it off,
     the original Feed-era copy stays until production flips the flag (W200).
     Neither version has screenshots, by the owner's choice.

     [App Store badge]: the App Store link is a text button until the owner
     supplies Apple's official badge file, which must be used unmodified. --%>

<%= if @recipe_first do %>
  <div class="mx-auto max-w-[1000px] px-[18px] md:px-12">
    <section class="mx-auto max-w-[720px] pt-6 pb-14 text-center md:pt-12 md:pb-20">
      <h1 class="font-display text-[34px] font-extrabold leading-[1.1] tracking-[-0.02em] text-base-content md:text-[52px]">
        Find something to cook tonight.
      </h1>
      <p class="mx-auto mt-4 max-w-[560px] text-[16px] leading-[1.55] text-muted md:text-[18px]">
        Trays is a recipe app for home cooks. Cook from your own tray, borrow a
        recipe from a friend's, or search by the ingredients you already have.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-2.5 sm:flex-row">
        <.primary_button href={~p"/users/register"}>Create your account</.primary_button>
        <.secondary_button href={app_store_url()}>Download on the App Store</.secondary_button>
      </div>
    </section>

    <section class="mx-auto max-w-[640px] space-y-4 pb-14 text-[15px] leading-[1.6] text-muted md:pb-20 md:text-[16px]">
      <p>
        Every post on Trays is a recipe: a photo, the ingredients and the
        steps. Save the ones you want to make and they stay in your tray.
      </p>
      <p>
        Searching by ingredient is free. Add what's in your kitchen and Trays
        shows what you can make now, and what you're an item or two away from.
      </p>
    </section>

    <section class="pb-16 md:pb-24">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
        <%= for {title, blurb, icon} <- [
          {"Home",
           "Recipes you opened recently, your friends' trays, and what's new this week from cooks you follow.",
           "hero-home"},
          {"Search", "Look up a dish, a cook, or the ingredients you have.", "hero-magnifying-glass"},
          {"My Tray", "The recipes you've posted and the ones you've saved, in one place.",
           "hero-bookmark"}
        ] do %>
          <div class="rounded-[22px] bg-base-100 px-5 py-5 text-base-content shadow-card md:px-6 md:py-6">
            <div class="mb-4 flex size-11 items-center justify-center rounded-full bg-cream-lift text-primary">
              <.icon name={icon} class="size-5" />
            </div>
            <h2 class="font-display text-[19px] font-bold leading-tight">{title}</h2>
            <p class="mt-1.5 text-[14px] leading-[1.55] text-muted">{blurb}</p>
          </div>
        <% end %>
      </div>
    </section>

    <section class="pb-16 md:pb-24">
      <div class="rounded-[28px] bg-cream-lift p-6 text-base-content md:p-10">
        <h2 class="font-display text-[26px] font-extrabold leading-[1.15] tracking-[-0.01em] md:text-[32px]">
          Recipes are free. Plus adds a few tools.
        </h2>
        <p class="mt-4 mb-8 max-w-[620px] text-[15px] leading-[1.6] text-muted md:text-[16px]">
          Every recipe on Trays is free to read, cook and save, and nothing you
          post goes behind a paywall.
          <%= if @paid_tier do %>
            Trays Plus is an optional subscription with collections, a weekly
            meal planner, a grocery list, and no ads.
          <% else %>
            Trays Plus will be an optional subscription with collections, a
            weekly meal planner, a grocery list, and no ads.
          <% end %>
        </p>
        <div class="border-t border-base-300 pt-6">
          <.plus_pricing paid_tier={@paid_tier} />
        </div>
      </div>
    </section>

    <.landing_footer />
  </div>
<% else %>
  <div class="px-6 md:px-8">
    <%!-- Hero --%>
    <section class="max-w-[860px] mx-auto text-center pt-6 md:pt-12 pb-14 md:pb-20">
      <div class="font-mono text-[11px] text-primary uppercase tracking-[0.18em] mb-4">
        For home cooks
      </div>
      <h1 class="font-serif-editorial text-[40px] md:text-[64px] leading-[1.02] tracking-[-0.015em] text-base-content mb-5">
        Cook more. <em class="text-primary">Scroll less.</em>
      </h1>
      <p class="text-[16px] md:text-[18px] text-base-content/70 leading-[1.55] max-w-[560px] mx-auto mb-8">
        Trays is a recipe-sharing community for home cooks. Follow the people
        whose food you love, save what you want to make next, and keep cooking
        simple.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <.link
          href={~p"/users/register"}
          class="inline-flex items-center justify-center gap-2 h-12 px-6 rounded-md bg-accent text-accent-content text-[15px] font-semibold hover:brightness-95 transition"
        >
          Create your account <.icon name="hero-arrow-right" class="size-4" />
        </.link>
        <a
          href={app_store_url()}
          class="inline-flex items-center justify-center h-12 px-6 rounded-md border border-base-300 bg-base-100 text-[15px] font-semibold text-base-content hover:bg-base-200 transition"
        >
          Download on the App Store
        </a>
      </div>
    </section>

    <%!-- What is Trays --%>
    <section class="max-w-[680px] mx-auto pb-14 md:pb-20">
      <div class="font-mono text-[11px] text-primary uppercase tracking-[0.18em] mb-4 text-center">
        What is Trays
      </div>
      <div class="space-y-4 text-[15px] md:text-[16px] text-base-content/75 leading-[1.6]">
        <p>
          Trays is a social network built around one thing: home cooking. Post a
          recipe with its ingredients, steps, and a photo, and it lands in the
          feeds of the cooks who follow you — in the order it was made, with no
          algorithm deciding what you see.
        </p>
        <p>
          Found something you want to make? Save it to your tray, your own
          running cookbook of recipes to come back to. Like, comment, and follow
          to keep up with the cooks whose food you love.
        </p>
      </div>
    </section>

    <%!-- Features strip — the three trays. --%>
    <section class="max-w-[1000px] mx-auto pb-16 md:pb-24">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
        <%= for {title, blurb, icon} <- [
          {"Feed", "What the cooks you follow are making, in the order they made it.",
            "hero-rectangle-stack"},
          {"Find", "Search by ingredient, time, or cuisine. Filter chips do the heavy lifting.",
            "hero-magnifying-glass"},
          {"My Tray", "Save anything you'd like to cook later. It's your personal cookbook.",
            "hero-bookmark"}
        ] do %>
          <div class="bg-base-100 border border-base-300 rounded-md p-5 md:p-6">
            <div class="w-11 h-11 rounded-full bg-secondary/35 text-primary flex items-center justify-center mb-4">
              <.icon name={icon} class="size-5" />
            </div>
            <div class="font-serif-editorial text-[22px] text-base-content leading-tight mb-1">
              {title}
            </div>
            <p class="text-[14px] text-base-content/70 leading-[1.55]">
              {blurb}
            </p>
          </div>
        <% end %>
      </div>
    </section>

    <%!-- Trays Plus — optional subscription. Utility only: this section must
         never imply recipes or the feed are gated. --%>
    <section class="max-w-[1000px] mx-auto pb-16 md:pb-24">
      <div class="border border-base-300 rounded-md bg-base-100 p-6 md:p-10">
        <div class="font-mono text-[11px] text-primary uppercase tracking-[0.18em] mb-4">
          Trays Plus
        </div>
        <h2 class="font-serif-editorial text-[28px] md:text-[36px] leading-[1.1] tracking-[-0.01em] text-base-content mb-4">
          Recipes stay free. <em class="text-primary">Plus adds the tools around them.</em>
        </h2>
        <p class="text-[15px] md:text-[16px] text-base-content/75 leading-[1.6] max-w-[620px] mb-8">
          Every recipe on Trays is free to read, cook, and save — that never
          changes, and nothing you post is ever put behind a paywall.
          <%= if @paid_tier do %>
            Trays Plus is an optional subscription for the kitchen tools we build
            around the free app.
          <% else %>
            Trays Plus will be an optional subscription for the kitchen tools we
            build around the free app.
          <% end %>
        </p>

        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 mb-8 list-none pl-0">
          <%= for {title, blurb} <- [
            {"Custom collections", "Organize your saved recipes onto your own shelves."},
            {"Weekly meal planner", "Plan a week of meals from recipes you have saved."},
            {"Automatic grocery list", "A plain checklist built from the week you planned."},
            {"No ads, anywhere", "Sponsored placements are removed throughout the app."}
          ] do %>
            <li class="flex items-start gap-3">
              <.icon name="hero-check" class="size-4 text-primary mt-1 shrink-0" />
              <span class="min-w-0">
                <span class="block text-[15px] font-semibold text-base-content">{title}</span>
                <span class="block text-[14px] text-base-content/70 leading-[1.5]">{blurb}</span>
              </span>
            </li>
          <% end %>
        </ul>

        <div class="border-t border-base-300 pt-6">
          <.plus_pricing paid_tier={@paid_tier} />
        </div>
      </div>
    </section>

    <.landing_footer />
  </div>
<% end %>
