<%!-- W203: the confirm-email gate. Every logged-in page sends an
     unconfirmed user here, and this page offers only the ways out:
     resend the link, fix the address in settings, or log out. Copy
     follows the iOS EmailVerificationGateView. W252 moves it into the
     WebAuth split panel with the canvas's mint "Check your email" box. --%>

<.auth_shell id="confirm-required">
  <.auth_heading title="Verify your email" subtitle="One last step before you start cooking." />

  <.auth_status title="Check your email" class="mt-6">
    We sent a verification link to <strong>{@email}</strong>.
    Open the link in that email, then come back here.
  </.auth_status>

  <div class="mt-6 flex flex-col gap-3">
    <.form for={%{}} id="resend-confirmation-form" action={~p"/users/confirmation/resend"}>
      <.accent_button
        type="submit"
        wide
        phx-disable-with="Sending…"
        class="min-h-[52px] text-base shadow-lg shadow-accent/30"
      >
        Resend verification email
      </.accent_button>
    </.form>

    <.secondary_button id="confirm-required-change-email" href={~p"/users/settings"} wide>
      Change email
    </.secondary_button>
  </div>

  <p class="mt-[22px] text-center text-[15px] text-muted">
    Wrong account?
    <.link
      id="confirm-required-log-out"
      href={~p"/users/log-out"}
      method="delete"
      class="inline-flex min-h-11 items-center px-1 font-semibold text-primary-ink hover:underline"
    >
      Log out
    </.link>
  </p>
</.auth_shell>
