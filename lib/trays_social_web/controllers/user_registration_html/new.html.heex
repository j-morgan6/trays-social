<%!-- Create account, per the WebAuth artboard (W252): brand panel beside
     the form, Continue with Apple first, then email. Field errors sit in
     place under their field in amber; the one page-level error (the D46
     neutral rate-limit message) is the amber callout above the button.
     The 13+ confirmation is a checkbox on the web. No username
     suggestions: they are an unscheduled idea (D16). --%>

<.auth_shell id="create-account">
  <.auth_heading title="Start your tray" subtitle="Save recipes you love and share your own." />

  <.auth_status :if={Phoenix.Flash.get(@flash, :info)} class="mt-6">
    {Phoenix.Flash.get(@flash, :info)}
  </.auth_status>

  <div class="mt-6 flex flex-col gap-4">
    <.apple_button />
    <.or_divider />

    <.form
      :let={f}
      for={@changeset}
      action={~p"/users/register"}
      class="flex flex-col gap-4"
    >
      <.auth_input
        field={f[:username]}
        type="text"
        label="Username"
        autocomplete="username"
        required
      />
      <.auth_input field={f[:email]} type="email" label="Email" autocomplete="email" required />
      <.auth_input
        field={f[:password]}
        type="password"
        label="Password"
        autocomplete="new-password"
        hint="At least 12 characters."
        required
      />
      <.auth_input
        field={f[:password_confirmation]}
        type="password"
        label="Confirm password"
        autocomplete="new-password"
        required
      />

      <.auth_checkbox
        field={f[:age_confirmation]}
        label="I confirm I am 13 years old or older."
        required
      />

      <.callout :if={Phoenix.Flash.get(@flash, :error)} id="registration-error">
        {Phoenix.Flash.get(@flash, :error)}
      </.callout>

      <.accent_button
        type="submit"
        wide
        phx-disable-with="Creating your account…"
        class="min-h-[52px] text-base shadow-lg shadow-accent/30"
      >
        Create account
      </.accent_button>

      <p class="text-center text-[12.5px] leading-normal text-muted">
        By creating an account, you agree to our
        <.link href={~p"/terms"} class="text-base-content underline">Terms</.link>
        and <.link href={~p"/privacy"} class="text-base-content underline">Privacy Policy</.link>.
      </p>
    </.form>
  </div>

  <p class="mt-[22px] text-center text-[15px] text-muted">
    Already have an account?
    <.link
      navigate={~p"/users/log-in"}
      class="inline-flex min-h-11 items-center px-1 font-semibold text-primary-ink hover:underline"
    >
      Log in
    </.link>
  </p>
</.auth_shell>
