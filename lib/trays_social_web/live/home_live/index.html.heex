<div class="mx-auto max-w-[1160px] px-[18px] md:px-12">
  <%= if @home do %>
    <header :if={!welcome?(@home)} id="home-greeting">
      <p :if={@kicker} class="text-[15px] font-semibold text-muted">{@kicker}</p>
      <h1 class="mt-1 font-display text-[31px] font-extrabold leading-[1.12] tracking-[-0.02em] text-base-content [overflow-wrap:anywhere] md:text-[38px]">
        {TraysSocialWeb.HomeFormatting.question(@current_scope.user.username)}
      </h1>
    </header>

    <section
      :if={welcome?(@home)}
      id="home-welcome"
      class="grid gap-6 rounded-[28px] bg-cream-lift px-5 pb-3.5 pt-[26px] text-base-content md:grid-cols-2 md:gap-12 md:p-11 md:pb-7"
    >
      <div>
        <p class="text-[15px] font-semibold text-muted">Welcome to Trays</p>
        <h1 class="mt-1 font-display text-[32px] font-extrabold leading-[1.12] tracking-[-0.02em]">
          Your tray starts here.
        </h1>
        <p class="mt-3 max-w-[420px] text-[15px] leading-normal text-muted">
          Post a recipe you already love, or save a few from other cooks. It fills up as you cook.
        </p>
        <div class="mt-6 flex flex-col gap-2.5 md:flex-row md:flex-wrap">
          <.primary_button navigate={~p"/posts/new"}>
            <.icon name="hero-plus" class="size-5" /> Post your first recipe
          </.primary_button>
          <.secondary_button navigate={~p"/search"}>
            <.icon name="hero-magnifying-glass" class="size-5" /> Find recipes in Search
          </.secondary_button>
        </div>
      </div>

      <div
        :if={@home.suggested_cooks != []}
        id="home-cooks"
        class="self-start rounded-[22px] bg-base-100 px-5 py-4 text-base-content shadow-card"
      >
        <h2 class="font-display text-[17px] font-bold">Cooks to follow</h2>
        <ul class="mt-2 divide-y divide-hairline">
          <li :for={cook <- @home.suggested_cooks}>
            <.link
              navigate={~p"/@#{cook.user.username}"}
              class="flex min-h-11 items-center gap-3 py-2.5"
            >
              <.user_avatar
                username={cook.user.username}
                photo_url={cook.user.profile_photo_url}
                size="lg"
                class="shrink-0"
              />
              <span class="flex min-w-0 flex-1 flex-col">
                <span class="truncate text-[15px] font-semibold">{cook.user.username}</span>
                <span class="text-[13px] text-muted">
                  {cook.recipe_count} {if cook.recipe_count == 1, do: "recipe", else: "recipes"}
                </span>
              </span>
              <.icon name="hero-chevron-right" class="size-4 shrink-0 text-muted" />
            </.link>
          </li>
        </ul>
      </div>
    </section>

    <section :if={@home.jump_back_in != []} id="home-jump-back-in" class="mt-8 md:mt-[42px]">
      <.section_heading title="Jump back in" />
      <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
        <.recipe_card
          :for={post <- @home.jump_back_in}
          navigate={~p"/posts/#{post.id}"}
          title={post_title(post)}
          photo_url={post.photo_url}
          aspect="4:3"
          cook_time={TraysSocialWeb.HomeFormatting.cook_time_label(post.cooking_time_minutes)}
          author_name={post.user.username}
          author_avatar_url={post.user.profile_photo_url}
        />
      </div>
    </section>

    <%!-- The web app has no planner page, so Tonight opens the recipe. --%>
    <.link
      :if={@home.tonight}
      id="home-tonight"
      navigate={~p"/posts/#{@home.tonight.post.id}"}
      class="mt-5 flex min-h-14 items-center gap-3 rounded-full bg-accent/25 p-1.5 pr-4 text-base-content ring-1 ring-inset ring-accent/32 md:mt-[26px] md:max-w-[640px]"
    >
      <span class="relative size-11 shrink-0 overflow-hidden rounded-full bg-cream-lift">
        <img
          :if={@home.tonight.post.photo_url}
          src={TraysSocial.Uploads.ImageProcessor.thumb_url(@home.tonight.post.photo_url)}
          alt=""
          class="absolute inset-0 size-full object-cover"
        />
      </span>
      <span class="flex min-w-0 flex-1 flex-col">
        <span class="text-[12.5px] font-bold">Tonight</span>
        <span class="truncate text-[15px] font-semibold">{post_title(@home.tonight.post)}</span>
      </span>
      <.icon name="hero-chevron-right" class="size-4 shrink-0 text-muted" />
    </.link>

    <section :if={@home.friends_trays != []} id="home-friends" class="mt-8 md:mt-[42px]">
      <.section_heading
        title="Friends' trays"
        see_all={~p"/@#{@current_scope.user.username}/following"}
      />
      <div class="-mx-[18px] flex gap-3 overflow-x-auto px-[18px] pb-1 md:mx-0 md:gap-[22px] md:px-0">
        <.link
          :for={friend <- @home.friends_trays}
          navigate={~p"/@#{friend.user.username}"}
          class="flex w-[70px] shrink-0 flex-col items-center gap-[7px] md:w-[84px]"
        >
          <.user_avatar
            username={friend.user.username}
            photo_url={friend.user.profile_photo_url}
            size="friend"
          />
          <span class="max-w-full truncate text-[13px] font-semibold text-base-content">
            {friend.user.username}
          </span>
        </.link>
      </div>
    </section>

    <section :if={@home.friends_trays != []} id="home-new" class="mt-8 md:mt-[42px]">
      <.section_heading title="New from people you follow" />
      <%= if @home.new_from_following == [] do %>
        <.end_card
          id="home-caught-up"
          title="Nothing new this week"
          message="When someone you follow posts a recipe, it shows up here for seven days."
          class="max-w-[440px] p-[22px]"
        />
      <% else %>
        <div class="-mx-[18px] flex snap-x snap-mandatory gap-3 overflow-x-auto px-[18px] pb-2 md:mx-0 md:gap-[18px] md:px-0">
          <.recipe_card
            :for={post <- @home.new_from_following}
            navigate={~p"/posts/#{post.id}"}
            title={post_title(post)}
            photo_url={post.photo_url}
            aspect="4:5"
            cook_time={TraysSocialWeb.HomeFormatting.cook_time_label(post.cooking_time_minutes)}
            badge={new_badge(post, @now)}
            author_name={post.user.username}
            author_avatar_url={post.user.profile_photo_url}
            context={TraysSocialWeb.HomeFormatting.time_ago(post.inserted_at, @now)}
            class="w-44 shrink-0 snap-start md:w-56"
          />
          <.end_card
            id="home-caught-up"
            title="You're caught up"
            message="That's everything from the last 7 days. Time to cook."
            class="w-44 shrink-0 snap-start justify-center md:w-56"
          />
        </div>
      <% end %>
    </section>
  <% else %>
    <%!-- Dead render: a link-free skeleton shaped like the loaded page. --%>
    <div id="home-loading" aria-hidden="true">
      <div class="h-4 w-[120px] rounded-md bg-base-300 animate-pulse motion-reduce:animate-none">
      </div>
      <div class="mt-2 h-[38px] w-[76%] max-w-[480px] rounded-lg bg-base-300 animate-pulse motion-reduce:animate-none">
      </div>
      <div class="mt-8 h-4 w-40 rounded-md bg-base-300 animate-pulse motion-reduce:animate-none md:mt-[42px]">
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
        <.skeleton_card :for={_ <- 1..6} aspect="4:3" />
      </div>
      <div class="mt-5 h-14 rounded-full bg-base-300 animate-pulse motion-reduce:animate-none md:mt-[26px] md:max-w-[640px]">
      </div>
      <div class="mt-8 flex gap-3 overflow-hidden md:mt-[42px] md:gap-[22px]">
        <div
          :for={_ <- 1..6}
          class="size-16 shrink-0 rounded-full bg-base-300 animate-pulse motion-reduce:animate-none md:size-[76px]"
        >
        </div>
      </div>
      <div class="mt-8 flex gap-3 overflow-hidden md:mt-[42px] md:gap-[18px]">
        <.skeleton_card :for={_ <- 1..4} aspect="4:5" class="w-44 shrink-0 md:w-56" />
      </div>
    </div>
  <% end %>
</div>
