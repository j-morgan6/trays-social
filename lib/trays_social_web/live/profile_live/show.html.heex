<%!-- W246: profile on the redesign canvas (More artboard, Profile), the web
     twin of iOS ProfileHeader (W245): a cream header card with the 96px
     avatar, name, handle, bio, Recipes / Followers / Following and one
     full-width Follow (Edit profile on your own), then "Recipes · Newest
     first" as a uniform 4:3 grid of equal-size cards. A profile never shows
     anyone's Saved list. --%>

<main class="mx-auto max-w-[1080px] px-4 pb-12 pt-8 md:px-8">
  <section
    id="profile-header"
    class="mx-auto flex max-w-[640px] flex-col items-center rounded-[28px] bg-cream-lift px-5 py-7 text-center md:px-8"
  >
    <.user_avatar username={@user.username} photo_url={@user.profile_photo_url} size="profile" />
    <h1 class="mt-4 w-full min-w-0 truncate font-display text-[28px] font-extrabold leading-tight tracking-[-0.02em] text-base-content">
      {@user.username}
    </h1>
    <p class="mt-0.5 w-full min-w-0 truncate text-[15px] text-muted">@{@user.username}</p>
    <p
      :if={@user.bio}
      class="mt-3 max-w-[440px] break-words text-[15px] leading-normal text-base-content"
    >
      {@user.bio}
    </p>

    <div id="profile-stats" class="mt-5 grid w-full grid-cols-3 gap-2">
      <%= if @loading do %>
        <div :for={_ <- 1..3} aria-hidden="true" class="flex flex-col items-center gap-1.5 py-1">
          <div class="h-6 w-10 rounded-md bg-base-300 animate-pulse motion-reduce:animate-none">
          </div>
          <div class="h-3 w-16 rounded-md bg-base-300 animate-pulse motion-reduce:animate-none">
          </div>
        </div>
      <% else %>
        <div class="flex flex-col items-center py-1">
          <span class="font-display text-[22px] font-extrabold leading-tight text-base-content">
            {format_count(@post_count)}
          </span>
          <span class="text-[13px] text-muted">Recipes</span>
        </div>
        <.link
          navigate={~p"/@#{@user.username}/followers"}
          class="flex flex-col items-center rounded-2xl py-1 transition-colors hover:bg-base-100/60"
        >
          <span class="font-display text-[22px] font-extrabold leading-tight text-base-content">
            {format_count(@follower_count)}
          </span>
          <span class="text-[13px] text-muted">Followers</span>
        </.link>
        <.link
          navigate={~p"/@#{@user.username}/following"}
          class="flex flex-col items-center rounded-2xl py-1 transition-colors hover:bg-base-100/60"
        >
          <span class="font-display text-[22px] font-extrabold leading-tight text-base-content">
            {format_count(@following_count)}
          </span>
          <span class="text-[13px] text-muted">Following</span>
        </.link>
      <% end %>
    </div>

    <%= if own_profile?(assigns) do %>
      <.secondary_button href={~p"/users/settings"} wide class="mt-5">
        Edit profile
      </.secondary_button>
    <% else %>
      <.follow_button
        following={@is_following}
        aria-label={
          if @is_following, do: "Following @#{@user.username}", else: "Follow @#{@user.username}"
        }
        phx-click="toggle-follow"
        class="mt-5 w-full"
      />
    <% end %>
  </section>

  <section id="profile-recipes" class="mt-10">
    <.section_heading title="Recipes" aside="Newest first" />

    <%= cond do %>
      <% @loading -> %>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5 lg:grid-cols-4">
          <.skeleton_card :for={_ <- 1..8} />
        </div>
      <% @posts == [] and own_profile?(assigns) -> %>
        <.empty_block
          id="profile-recipes-empty"
          title="Your first recipe goes here."
          message="The one you make without looking is a good place to start."
        >
          <:action>
            <.primary_button navigate={~p"/posts/new"}>Post a recipe</.primary_button>
          </:action>
        </.empty_block>
      <% @posts == [] -> %>
        <.empty_block
          id="profile-recipes-empty"
          title="No recipes yet."
          message={"When @#{@user.username} posts a recipe, it shows up here."}
        />
      <% true -> %>
        <div
          id="profile-posts"
          class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5 lg:grid-cols-4"
        >
          <%= for post <- @posts do %>
            <% photo_post = photo_post?(post, @recipe_first) %>
            <.recipe_card
              navigate={~p"/posts/#{post.id}"}
              title={card_title(post, photo_post)}
              photo_url={post.photo_url}
              kind={if photo_post, do: :photo_post, else: :recipe}
              data-legacy-photo-label={photo_post}
              cook_time={HomeFormatting.cook_time_label(post.cooking_time_minutes)}
              context={HomeFormatting.time_ago(post.inserted_at, @now)}
            />
          <% end %>
        </div>
    <% end %>
  </section>
</main>
