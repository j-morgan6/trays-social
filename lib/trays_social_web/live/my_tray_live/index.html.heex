<%!-- W246: My Tray on the redesign canvas (Main artboard, My Tray), the
     web twin of iOS MyTrayView (W245): rounded title and count line, then
     with recipe_first on a pill switch between My recipes and Saved, each a
     uniform 4:3 grid of equal-size recipe cards. No collections shelf or
     planner card: neither has a web route (D16). With the flag off the page
     shows only the Saved grid. --%>

<main class="mx-auto max-w-[1080px] px-4 pb-12 pt-8 md:px-8">
  <header id="my-tray-header">
    <h1 class="font-display text-[32px] font-extrabold leading-tight tracking-[-0.02em] text-base-content md:text-[40px]">
      My Tray
    </h1>
    <p :if={subtitle(assigns)} class="mt-1.5 text-[15px] text-muted">{subtitle(assigns)}</p>
  </header>

  <.segmented_pills
    :if={@recipe_first}
    id="my-tray-switch"
    label="My Tray lists"
    options={list_options(assigns)}
    class="mb-4 mt-6 max-w-[480px]"
  />

  <%= cond do %>
    <% @loading -> %>
      <%!-- Link-free skeleton in the grid's shape. --%>
      <div id="my-tray-loading" class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
        <.skeleton_card :for={_ <- 1..6} />
      </div>
    <% @recipe_first and @list == :recipes -> %>
      <h2 class="sr-only">My recipes</h2>
      <.empty_block
        :if={@my_recipes == []}
        id="my-tray-recipes-empty"
        title="Your first recipe goes here."
        message="The one you make without looking is a good place to start."
      >
        <:action>
          <.primary_button navigate={~p"/posts/new"}>Post a recipe</.primary_button>
        </:action>
      </.empty_block>
      <div
        :if={@my_recipes != []}
        id="my-tray-recipes"
        class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5"
      >
        <%!-- A cook's own tray names no author (iOS showsAuthor false). --%>
        <.recipe_card
          :for={post <- @my_recipes}
          navigate={~p"/posts/#{post.id}"}
          title={TrayFormatting.post_title(post)}
          photo_url={post.photo_url}
          cook_time={HomeFormatting.cook_time_label(post.cooking_time_minutes)}
          context={HomeFormatting.time_ago(post.inserted_at, @now)}
        />
      </div>
    <% @recipe_first and @bookmarks == [] -> %>
      <h2 id="my-tray-saved-heading" class="sr-only">Saved</h2>
      <.empty_block
        id="my-tray-saved-empty"
        title="Nothing saved yet."
        message="Save a recipe from Search or a friend's tray and it waits here."
      >
        <:action>
          <.primary_button navigate={~p"/search"}>Find recipes in Search</.primary_button>
        </:action>
      </.empty_block>
    <% @bookmarks == [] -> %>
      <.empty_block
        id="my-tray-empty"
        class="mt-6"
        title="Nothing saved yet."
        message="Tap the bookmark on any recipe to save it here."
      >
        <:action>
          <.primary_button navigate={~p"/explore"}>Find recipes to save</.primary_button>
        </:action>
      </.empty_block>
    <% true -> %>
      <h2 :if={@recipe_first} id="my-tray-saved-heading" class="sr-only">Saved</h2>
      <div
        id={if @recipe_first, do: "my-tray-saved", else: "saved-recipes"}
        class={["grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5", !@recipe_first && "mt-6"]}
      >
        <%= for bookmark <- @bookmarks do %>
          <% post = bookmark.post %>
          <% photo_post = photo_post?(post, @recipe_first) %>
          <.recipe_card
            navigate={~p"/posts/#{post.id}"}
            title={card_title(post, photo_post)}
            photo_url={post.photo_url}
            kind={if photo_post, do: :photo_post, else: :recipe}
            data-legacy-photo-label={photo_post}
            cook_time={HomeFormatting.cook_time_label(post.cooking_time_minutes)}
            author_name={post.user.username}
            author_avatar_url={post.user.profile_photo_url}
            context={TrayFormatting.saved_on(bookmark.inserted_at)}
          />
        <% end %>
      </div>
  <% end %>
</main>
