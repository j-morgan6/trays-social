<%!-- Find / Search. W244 restyles it to the redesign canvas (Main artboard,
     web Search): the capsule search field, ingredient chips, and below it
     Browse / grouped results / ingredient results on the shared
     DesignComponents. The classic (flag-off) Find keeps its filter chips,
     results grid and discovery rails. --%>

<% has_chips = MapSet.size(@active_chips) > 0 %>
<% is_searching = @search_route != :idle or has_chips or not is_nil(@category) %>
<% matching_ingredients = match?({:ingredients, _}, @search_route) %>

<%!-- One search box (W205): Enter turns the typed text into an ingredient
     chip. One term searches normally; two or more switch the results to
     "You have everything" / "Almost there". SearchPrefs (assets/js/app.js)
     restores recently used ingredient chips from localStorage on mount, and
     stores them again whenever the server pushes "search-prefs". --%>
<div id="search-prefs" phx-hook="SearchPrefs">
  <%!-- Sticky search + chips bar (pinning unchanged in W244) --%>
  <div class="sticky top-16 z-10 border-b border-hairline bg-base-200/95 backdrop-blur-[20px]">
    <div class="mx-auto max-w-[1160px] px-[18px] pt-5 pb-4 md:px-12">
      <.form
        for={%{}}
        as={:search}
        id="search-form"
        phx-change="search"
        phx-submit="submit-search"
        class="max-w-[760px]"
      >
        <div class="flex min-h-14 items-center gap-2.5 rounded-full bg-base-100 pl-4 pr-1.5 ring-1 ring-inset ring-border transition-shadow focus-within:ring-2 focus-within:ring-accent focus-within:outline-4 focus-within:outline-accent/25">
          <.icon name="hero-magnifying-glass" class="size-5 shrink-0 text-muted" />
          <%!-- The id changes with the chip count so a submitted term
                 remounts an empty, focused input. --%>
          <input
            id={"search-input-#{length(@ingredient_chips)}"}
            type="text"
            name="query"
            value={@query}
            aria-label="Search recipes, ingredients, cooks"
            phx-mounted={@ingredient_chips != [] && JS.focus()}
            placeholder="Search recipes, ingredients, cooks…"
            autocomplete="off"
            class="h-[50px] min-w-0 flex-1 border-0 bg-transparent text-base text-base-content outline-none placeholder:text-muted"
            phx-debounce="200"
          />
          <%= if is_searching do %>
            <span
              :if={!@recipe_first and !matching_ingredients}
              class="shrink-0 font-mono text-[11px] uppercase tracking-[0.1em] text-muted"
            >
              {length(@results)} {if length(@results) == 1, do: "match", else: "matches"}
            </span>
            <button
              type="button"
              phx-click="clear-search"
              class="grid size-11 shrink-0 place-items-center rounded-full text-muted transition-colors hover:text-base-content focus-visible:outline-2 focus-visible:outline-primary"
              aria-label="Clear search"
            >
              <.icon name="hero-x-mark" class="size-5" />
            </button>
          <% end %>
        </div>
      </.form>

      <IngredientComponents.chip_bar
        chips={@ingredient_chips}
        recent={@recent_ingredients}
        typing={@query != ""}
        max_chips={@max_ingredient_chips}
      />

      <%!-- recipe_first replaces the filter chips with Browse tiles. --%>
      <div :if={!@recipe_first} class="mt-3 flex flex-wrap gap-2">
        <%= for chip <- @chips do %>
          <% on = MapSet.member?(@active_chips, chip.id) %>
          <button
            type="button"
            phx-click="toggle-chip"
            phx-value-id={chip.id}
            class={[
              "inline-flex items-center gap-1.5 h-8 px-3.5 rounded-full text-[13px] transition-colors",
              if(on,
                do: "bg-primary text-primary-content border border-primary",
                else:
                  "bg-base-100 text-base-content border border-base-300 hover:border-base-content/30"
              )
            ]}
          >
            <.icon name={chip.icon} class="size-3" />
            {chip.label}
            <%= if on do %>
              <.icon name="hero-x-mark" class="size-3 opacity-70 -mr-1" />
            <% end %>
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[1160px] px-[18px] pt-6 pb-12 md:px-12">
    <%!-- State e: while a search event is in flight LiveView puts
         phx-change-loading / phx-submit-loading on #search-form, and the
         search-loading variant (app.css) swaps the results below for a
         skeleton in the shape of the current results (recipe-first and
         ingredient views only; classic Find keeps its results visible).
         The form keeps its plain
         phx-change="search" so its event name and selectors are unchanged. --%>
    <div id="search-results">
      <RecipeFirstComponents.results_skeleton
        :if={@recipe_first or matching_ingredients}
        ingredients={matching_ingredients}
      />
      <div
        id="search-results-content"
        class={(@recipe_first or matching_ingredients) && "search-loading:hidden"}
      >
        <%= if matching_ingredients do %>
          <IngredientComponents.ingredient_results
            results={@ingredient_results}
            terms={elem(@search_route, 1)}
          />
        <% else %>
          <%= if @recipe_first do %>
            <%= if @groups do %>
              <RecipeFirstComponents.grouped_results groups={@groups} show_ads={@show_ads} />
            <% else %>
              <RecipeFirstComponents.browse
                categories={@categories}
                most_saved={@most_saved}
                loading={@loading}
                show_ads={@show_ads}
              />
            <% end %>
          <% else %>
            <%= cond do %>
              <% @loading -> %>
                <%!-- Loading skeleton --%>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                  <%= for _ <- 1..6 do %>
                    <div class="bg-base-100 border border-base-300 rounded-sm overflow-hidden">
                      <div class="aspect-[4/3] bg-base-300 animate-pulse"></div>
                      <div class="p-4 space-y-2">
                        <.loading_skeleton type="text" class="w-3/4 h-6" />
                        <.loading_skeleton type="text" class="w-1/2 h-3" />
                      </div>
                    </div>
                  <% end %>
                </div>
              <% is_searching -> %>
                <%!-- Search results --%>
                <div class="flex items-baseline gap-3 mb-5 flex-wrap">
                  <h2 class="font-display text-[28px] text-base-content leading-none">
                    <%= cond do %>
                      <% length(@results) == 0 -> %>
                        No recipes found
                      <% length(@results) == 1 -> %>
                        1 recipe for you
                      <% true -> %>
                        {length(@results)} recipes for you
                    <% end %>
                  </h2>
                  <%= if length(@results) > 0 do %>
                    <div class="text-xs text-base-content/60">
                      Sorted by time
                      <%= if has_chips do %>
                        · matching {MapSet.size(@active_chips)} {if MapSet.size(@active_chips) ==
                                                                      1,
                                                                    do: "chip",
                                                                    else: "chips"}
                      <% end %>
                    </div>
                  <% end %>
                </div>

                <%= if length(@results) == 0 do %>
                  <div class="bg-base-100 border border-base-300 rounded-sm p-10 text-center">
                    <p class="font-display text-[17px] text-base-content/70 mb-2">
                      Nothing matches that yet.
                    </p>
                    <p class="text-sm text-base-content/60">
                      Try fewer chips, a different ingredient, or a cook's name.
                    </p>
                  </div>
                <% else %>
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
                    <%= for post <- @results do %>
                      <% title = post_title(post) %>
                      <.link
                        navigate={~p"/posts/#{post.id}"}
                        class="block bg-base-100 border border-base-300 rounded-sm overflow-hidden hover:border-base-content/20 transition-colors group"
                      >
                        <div class="aspect-[4/3] bg-base-200 overflow-hidden">
                          <img
                            src={TraysSocial.Uploads.ImageProcessor.thumb_url(post.photo_url)}
                            alt={title}
                            class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                          />
                        </div>
                        <div class="p-4">
                          <h4 class="font-display text-[20px] leading-[1.1] text-base-content mb-1.5 line-clamp-2">
                            {title}
                          </h4>
                          <div class="text-[12px] text-base-content/60">
                            {post.user.username}
                            <%= if post.cooking_time_minutes do %>
                              · {post.cooking_time_minutes} min
                            <% end %>
                            <%= if Ecto.assoc_loaded?(post.ingredients) and length(post.ingredients) > 0 do %>
                              · {length(post.ingredients)} ingredients
                            <% end %>
                          </div>
                          <div class="flex items-center gap-3 mt-3 pt-3 border-t border-base-300 text-[11px] text-base-content/60">
                            <span class="inline-flex items-center gap-1">
                              <.icon name="hero-heart" class="size-3" /> {post.like_count}
                            </span>
                            <span class="inline-flex items-center gap-1">
                              <.icon name="hero-chat-bubble-left-ellipsis" class="size-3" /> {post.comment_count}
                            </span>
                          </div>
                        </div>
                      </.link>
                    <% end %>
                  </div>
                <% end %>
              <% true -> %>
                <%!-- Empty-state discovery — trending / new / by tag.
                 Restyled in editorial card style, kept as horizontal scroll
                 rails so the surface remains scannable. --%>
                <%= if Enum.empty?(@trending) and Enum.empty?(@recent) and Enum.empty?(@tag_sections) do %>
                  <.empty_state message="Nothing to find yet — be the first to post something.">
                    <%= if assigns[:current_scope] && @current_scope.user do %>
                      <.link
                        href={~p"/posts/new"}
                        class="inline-flex items-center gap-1.5 h-10 px-5 rounded-md bg-accent text-accent-content text-sm font-semibold hover:brightness-95 transition"
                      >
                        <.icon name="hero-plus" class="size-4" /> Share the first recipe
                      </.link>
                    <% end %>
                  </.empty_state>
                <% else %>
                  <%!-- Discovery rails (horizontal scroll) — Trending, New, then
                   one rail per top tag. Each rail uses the editorial portrait
                   tile so the surface reads as cookbook chapters rather than
                   Instagram squares. --%>
                  <% rails =
                    [
                      {"Popular this week", @trending},
                      {"New on Trays", @recent}
                    ] ++
                      Enum.map(@tag_sections, fn {tag, posts} ->
                        {String.capitalize(tag), posts}
                      end) %>

                  <%= for {eyebrow, posts} <- rails, not Enum.empty?(posts) do %>
                    <section class="mb-10">
                      <div class="font-display text-[22px] text-base-content mb-3">
                        {eyebrow}
                      </div>
                      <div class="flex gap-4 overflow-x-auto pb-2 -mx-[18px] md:-mx-12 px-[18px] md:px-12 snap-x snap-mandatory scrollbar-hide">
                        <%= for post <- posts do %>
                          <.link
                            navigate={~p"/posts/#{post.id}"}
                            class="shrink-0 w-44 md:w-52 snap-start group"
                          >
                            <div class="aspect-[4/5] rounded-sm overflow-hidden bg-base-200 relative">
                              <img
                                src={TraysSocial.Uploads.ImageProcessor.thumb_url(post.photo_url)}
                                alt={post_title(post)}
                                class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                              />
                              <div class="absolute inset-x-0 bottom-0 pt-10 pb-3 px-3 bg-gradient-to-t from-black/65 to-transparent">
                                <h4 class="font-display text-white text-[16px] leading-[1.1] line-clamp-2">
                                  {post_title(post)}
                                </h4>
                                <%= if post.cooking_time_minutes do %>
                                  <div class="font-mono text-[10px] uppercase tracking-[0.1em] text-white/80 mt-1">
                                    {post.cooking_time_minutes} min
                                  </div>
                                <% end %>
                              </div>
                            </div>
                            <div class="text-[12px] text-base-content/60 mt-2 truncate">
                              {post.user.username}
                            </div>
                          </.link>
                        <% end %>
                      </div>
                    </section>
                  <% end %>
                <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
