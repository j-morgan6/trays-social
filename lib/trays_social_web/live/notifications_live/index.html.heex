<%!-- W246: notifications on the redesign canvas (More artboard): the rounded
     "Notes for you" heading and count line, one rounded surface list (newest
     first, amber dot for unread), a mint end card, and an empty block when
     there is nothing. The empty block and end card are driven by
     @total_count, outside the stream, so #notifications stays in the DOM
     for live inserts. --%>

<main class="mx-auto max-w-[720px] px-4 pb-12 pt-8 md:px-8">
  <header class="mb-5">
    <h1 class="font-display text-[32px] font-extrabold leading-tight tracking-[-0.02em] text-base-content md:text-[40px]">
      Notes for you
    </h1>
    <p :if={@total_count > 0} class="mt-1.5 text-[15px] text-muted">
      {@total_count} {if @total_count == 1, do: "note", else: "notes"} · {@unread_count} unread
    </p>
  </header>

  <.empty_block
    :if={@total_count == 0}
    id="notifications-empty"
    title="Nothing yet."
    message="When someone saves your recipe, leaves a note or follows you, it shows up here."
  />

  <div
    id="notifications"
    phx-update="stream"
    class={[
      "divide-y divide-hairline overflow-hidden rounded-3xl bg-base-100 shadow-card",
      @total_count == 0 && "hidden"
    ]}
  >
    <div
      :for={{dom_id, n} <- @streams.notifications}
      id={dom_id}
      class={["relative", is_nil(n.read_at) && "bg-accent/[0.06]"]}
    >
      <span
        :if={is_nil(n.read_at)}
        class="absolute left-2 top-1/2 size-1.5 -translate-y-1/2 rounded-full bg-accent"
      >
      </span>

      <.link
        navigate={target_path(n)}
        class="grid grid-cols-[40px_minmax(0,1fr)_auto] items-center gap-3.5 px-5 py-4 transition-colors hover:bg-base-300/40 md:px-6"
      >
        <.user_avatar username={actor_name(n)} photo_url={actor_photo(n)} size="md" />

        <div class="min-w-0">
          <p class="text-[15px] leading-snug text-base-content [overflow-wrap:anywhere]">
            <%= case n.type do %>
              <% "like" -> %>
                <span class="font-semibold">{actor_name(n)}</span>
                found your <span class="font-semibold">{post_title(n.post) || "recipe"}</span>
                helpful
              <% "comment" -> %>
                <span class="font-semibold">{actor_name(n)}</span>
                left a note on
                <span class="font-semibold">{post_title(n.post) || "your recipe"}</span>
              <% "follow" -> %>
                <span class="font-semibold">{actor_name(n)}</span> followed you
              <% _ -> %>
                <span class="font-semibold">{actor_name(n)}</span> interacted with you
            <% end %>
          </p>
          <p :if={actor_bio(n)} class="mt-1 truncate text-[13px] text-muted">{actor_bio(n)}</p>
          <p class="mt-1 text-[12.5px] text-muted">{relative_time(n.inserted_at)}</p>
        </div>

        <%= cond do %>
          <% n.post -> %>
            <div class="size-[60px] shrink-0 overflow-hidden rounded-[14px] bg-cream-lift">
              <img
                src={TraysSocial.Uploads.ImageProcessor.thumb_url(n.post.photo_url)}
                alt=""
                class="size-full object-cover"
              />
            </div>
          <% n.type == "follow" -> %>
            <%!-- Visual only: the whole row links to the cook's profile. --%>
            <span class="inline-flex min-h-8 items-center rounded-full bg-primary px-3.5 text-[13px] font-semibold text-primary-content">
              Follow back
            </span>
          <% true -> %>
            <span></span>
        <% end %>
      </.link>
    </div>
  </div>

  <.end_card
    :if={@total_count > 0}
    id="notifications-end"
    class="mt-5"
    title="That's everything."
    message="Quiet by design. We don't ping you for the algorithm's sake."
  />
</main>
