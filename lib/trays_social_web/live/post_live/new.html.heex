<%!-- Recipe editor (W250), per the redesign canvas Create artboard (web).
     Desktop: the editor cards on the left, a sticky preview, checklist and
     Post button on the right. Narrower than lg it is one column with the
     aside last. Missing or invalid fields show amber notes, never red.

     The LiveView events (validate / save / add-ingredient / remove-step /
     cancel-upload / ...), the form id and every input name are unchanged.
     Not built here (spec D16): "Paste a list", drafts that save as you go,
     step timers. The canvas's "Add to a collection" card and full-screen
     preview are not existing behaviour either; the aside card is the
     preview. Flag off, the type picker and the photo post form still
     render in the same style. --%>

<%= if @post_type == nil do %>
  <%!-- Type picker (recipe_first off only). --%>
  <main id="editor-picker" class="mx-auto max-w-[760px] px-4 pb-16 pt-10 md:px-10 md:pt-14">
    <div class="mb-8 text-center">
      <h1 class="font-display text-[32px] font-extrabold leading-tight tracking-[-0.02em] md:text-[38px]">
        What are you sharing?
      </h1>
      <p class="mt-2 text-[15px] text-muted">
        A recipe is a full page: ingredients, tools, method. A post is a quick note about something you made.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <button
        type="button"
        phx-click="select-type"
        phx-value-type="recipe"
        class="min-w-0 rounded-[22px] bg-base-100 p-6 text-left shadow-card transition hover:ring-2 hover:ring-accent/32 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <h2 class="font-display text-[22px] font-extrabold">Write a recipe</h2>
        <p class="mt-1.5 text-[14px] leading-normal text-muted">
          Photo, ingredients, tools, cooking time, step-by-step method. Becomes a page someone could cook from.
        </p>
      </button>

      <button
        type="button"
        phx-click="select-type"
        phx-value-type="post"
        class="min-w-0 rounded-[22px] bg-base-100 p-6 text-left shadow-card transition hover:ring-2 hover:ring-accent/32 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <h2 class="font-display text-[22px] font-extrabold">Share a post</h2>
        <p class="mt-1.5 text-[14px] leading-normal text-muted">
          A photo and a caption. For when you just want to show what you ate, not write the recipe up.
        </p>
      </button>
    </div>

    <div class="mt-8 flex justify-center">
      <.secondary_button navigate={~p"/feed"}>Cancel</.secondary_button>
    </div>
  </main>
<% else %>
  <% is_recipe = @post_type == "recipe" %>

  <main id="editor" class="mx-auto max-w-[1120px] px-4 pb-16 pt-8 md:px-10 md:pt-10">
    <header id="editor-head" class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-0">
        <h1 class="break-words font-display text-[32px] font-extrabold leading-tight tracking-[-0.02em] md:text-[38px]">
          {if is_recipe, do: "New recipe", else: "New post"}
        </h1>
        <p class="mt-1.5 text-[15px] text-muted">
          {if is_recipe,
            do: "A photo, the total time, one ingredient and one step are needed to post.",
            else: "A photo and a few words. No recipe required."}
        </p>
      </div>
      <button
        :if={!@recipe_first}
        type="button"
        phx-click="back-to-picker"
        class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 text-[14.5px] font-semibold text-primary-ink hover:bg-mint-tint"
      >
        <.icon name="hero-arrow-left" class="size-4" /> Pick type
      </button>
    </header>

    <.form
      :let={f}
      for={@changeset}
      id="post-form"
      phx-change="validate"
      phx-submit="save"
      class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-10"
    >
      <div id="editor-fields" class="flex min-w-0 flex-col gap-3.5">
        <%!-- Photos --%>
        <section id="editor-photo" aria-label="Photos" class="min-w-0">
          <.live_file_input upload={@uploads.photos} class="sr-only" />

          <div
            id="photo-drop-zone"
            class="overflow-hidden rounded-[22px] transition-colors phx-drop-target:ring-2 phx-drop-target:ring-accent"
            phx-drop-target={@uploads.photos.ref}
          >
            <%= if @uploads.photos.entries == [] do %>
              <label
                for={@uploads.photos.ref}
                class="flex aspect-[4/3] w-full cursor-pointer flex-col items-center justify-center gap-2 rounded-[22px] border-[1.5px] border-dashed border-hairline-strong bg-base-100 p-4 text-center md:aspect-[16/7]"
              >
                <.icon name="hero-camera" class="size-7 text-muted" />
                <span class="font-display text-[17px] font-extrabold">Add a photo</span>
                <span class="text-[13px] text-muted">
                  Up to 5 photos. PNG, JPG or HEIC, up to 10MB each.
                </span>
              </label>
            <% else %>
              <div class="grid grid-cols-3 gap-2 rounded-[22px] bg-base-100 p-2 shadow-card sm:grid-cols-5">
                <div
                  :for={entry <- @uploads.photos.entries}
                  class="relative aspect-square min-w-0 overflow-hidden rounded-[15px] bg-cream-lift"
                >
                  <.live_img_preview entry={entry} class="size-full object-cover" />

                  <div
                    :if={entry.progress > 0 && entry.progress < 100}
                    class="absolute inset-0 flex items-center justify-center bg-base-content/40"
                  >
                    <span class="text-sm font-bold text-base-100">{trunc(entry.progress)}%</span>
                  </div>

                  <button
                    type="button"
                    class="absolute right-1 top-1 grid size-9 place-items-center rounded-full bg-pill text-base-content backdrop-blur-[20px]"
                    phx-click="cancel-upload"
                    phx-value-ref={entry.ref}
                    aria-label="Remove photo"
                  >
                    <.icon name="hero-x-mark" class="size-4" />
                  </button>
                </div>

                <label
                  :if={length(@uploads.photos.entries) < 5}
                  for={@uploads.photos.ref}
                  class="flex aspect-square cursor-pointer flex-col items-center justify-center rounded-[15px] border-[1.5px] border-dashed border-hairline-strong text-muted hover:bg-mint-tint"
                >
                  <.icon name="hero-plus" class="size-6" />
                  <span class="mt-1 text-[12px] font-semibold">Add more</span>
                </label>
              </div>
            <% end %>
          </div>

          <.field_note
            id="editor-photo-note"
            messages={
              for(
                entry <- @uploads.photos.entries,
                err <- upload_errors(@uploads.photos, entry),
                do: "#{entry.client_name}: #{error_to_string(err)}"
              ) ++
                Enum.map(upload_errors(@uploads.photos), &error_to_string/1)
            }
          />
        </section>

        <%!-- Basics: one caption field (the API stores one caption; its first
             line is the recipe name), then time and servings. --%>
        <.editor_card id="editor-basics" title={if is_recipe, do: "Basics", else: "Caption"}>
          <% caption_errors = field_errors(f[:caption]) %>
          <label for={f[:caption].id} class="mb-2 block text-[13.5px] font-semibold">
            {if is_recipe, do: "Recipe name and a line about it", else: "Describe your dish"}
          </label>
          <div class={[
            "flex rounded-[14px] bg-base-200 px-3.5 ring-inset focus-within:ring-2 focus-within:ring-accent",
            if(caption_errors == [],
              do: "ring-1 ring-hairline-strong",
              else: "ring-[1.5px] ring-accent"
            )
          ]}>
            <textarea
              id={f[:caption].id}
              name={f[:caption].name}
              rows="4"
              phx-debounce="300"
              placeholder={
                if is_recipe,
                  do: "Sesame chicken thighs\nWhen you make it, and what makes it good",
                  else: "Tell us about it"
              }
              aria-describedby={if is_recipe, do: "editor-caption-hint"}
              class="min-h-[96px] w-full resize-y border-0 bg-transparent px-0 py-3 text-base leading-normal text-base-content outline-none placeholder:text-muted focus:ring-0"
            >{Phoenix.HTML.Form.normalize_value("textarea", f[:caption].value)}</textarea>
          </div>
          <p :if={is_recipe} id="editor-caption-hint" class="mt-2 text-[13px] text-muted">
            The first line is the recipe name. The rest is the note people read first.
          </p>
          <.field_note id="editor-caption-note" messages={caption_errors} />

          <div :if={is_recipe} class="mt-3.5 grid grid-cols-2 gap-3">
            <div
              :for={
                {field, label, placeholder, required} <- [
                  {f[:cooking_time_minutes], "Total time (minutes)", "30", true},
                  {f[:servings], "Serves", "4", false}
                ]
              }
              class="min-w-0"
            >
              <% errors = field_errors(field) %>
              <label
                for={field.id}
                class={[
                  "flex min-w-0 flex-col gap-1 rounded-2xl bg-base-200 px-3.5 py-2.5 ring-inset focus-within:ring-2 focus-within:ring-accent",
                  if(errors == [],
                    do: "ring-1 ring-hairline-strong",
                    else: "ring-[1.5px] ring-accent"
                  )
                ]}
              >
                <span class="text-[12.5px] font-semibold text-muted">{label}</span>
                <input
                  type="number"
                  id={field.id}
                  name={field.name}
                  value={Phoenix.HTML.Form.normalize_value("number", field.value)}
                  placeholder={placeholder}
                  min="1"
                  required={required}
                  phx-debounce="300"
                  class="w-full min-w-0 border-0 bg-transparent p-0 font-display text-[17px] font-extrabold text-base-content outline-none placeholder:font-sans placeholder:font-normal placeholder:text-muted focus:ring-0"
                />
              </label>
              <.field_note id={"#{field.id}-note"} messages={errors} />
            </div>
          </div>
        </.editor_card>

        <%= if is_recipe do %>
          <%!-- Ingredients. Phone: the name on its own line, amount and unit
               below; from sm: amount | ingredient | unit. --%>
          <.editor_card id="editor-ingredients" title="Ingredients" aside="At least one">
            <div class="flex flex-col">
              <div
                :for={{row_id, display_idx} <- Enum.with_index(@ingredient_rows)}
                class="flex items-start gap-2 border-b border-hairline py-2 last:border-b-0"
              >
                <div class="grid min-w-0 flex-1 grid-cols-2 gap-2 sm:grid-cols-[92px_minmax(0,1fr)_88px]">
                  <input
                    type="text"
                    name={"post[ingredients][#{row_id}][quantity]"}
                    value={field_value(@form_params, "ingredients", row_id, "quantity")}
                    placeholder="Amount"
                    aria-label={"Amount, ingredient #{display_idx + 1}"}
                    class="min-h-[50px] w-full min-w-0 rounded-[14px] border-0 bg-base-200 px-3.5 text-base text-base-content ring-1 ring-inset ring-hairline-strong outline-none placeholder:text-muted focus:ring-2 focus:ring-accent"
                  />
                  <input
                    type="text"
                    name={"post[ingredients][#{row_id}][name]"}
                    value={field_value(@form_params, "ingredients", row_id, "name")}
                    placeholder="Ingredient"
                    required
                    aria-label={"Ingredient #{display_idx + 1}"}
                    class="order-first col-span-2 min-h-[50px] w-full min-w-0 rounded-[14px] border-0 bg-base-200 px-3.5 text-base text-base-content ring-1 ring-inset ring-hairline-strong outline-none placeholder:text-muted focus:ring-2 focus:ring-accent sm:order-none sm:col-span-1"
                  />
                  <input
                    type="text"
                    name={"post[ingredients][#{row_id}][unit]"}
                    value={field_value(@form_params, "ingredients", row_id, "unit")}
                    placeholder="Unit"
                    aria-label={"Unit, ingredient #{display_idx + 1}"}
                    class="min-h-[50px] w-full min-w-0 rounded-[14px] border-0 bg-base-200 px-3.5 text-base text-base-content ring-1 ring-inset ring-hairline-strong outline-none placeholder:text-muted focus:ring-2 focus:ring-accent"
                  />
                  <input
                    type="hidden"
                    name={"post[ingredients][#{row_id}][order]"}
                    value={display_idx}
                  />
                </div>
                <button
                  :if={length(@ingredient_rows) > 1}
                  type="button"
                  class="grid size-11 shrink-0 place-items-center rounded-full text-muted hover:bg-base-300 hover:text-base-content"
                  phx-click="remove-ingredient"
                  phx-value-id={row_id}
                  aria-label={"Remove ingredient #{display_idx + 1}"}
                >
                  <.icon name="hero-x-mark" class="size-5" />
                </button>
              </div>
            </div>
            <div class="mt-2 flex flex-wrap items-center gap-3">
              <.add_row_button phx-click="add-ingredient">Add ingredient</.add_row_button>
            </div>
          </.editor_card>

          <%!-- Steps --%>
          <.editor_card id="editor-steps" title="Steps" aside="At least one">
            <div class="flex flex-col">
              <div
                :for={{row_id, display_idx} <- Enum.with_index(@step_rows)}
                class="flex items-start gap-3 border-b border-hairline py-2.5 last:border-b-0"
              >
                <span class="mt-2.5 grid size-[30px] shrink-0 place-items-center rounded-full bg-accent/25 font-display text-sm font-extrabold">
                  {display_idx + 1}
                </span>
                <div class="flex min-w-0 flex-1 rounded-[14px] bg-base-200 px-3.5 ring-1 ring-inset ring-hairline-strong focus-within:ring-2 focus-within:ring-accent">
                  <textarea
                    name={"post[cooking_steps][#{row_id}][description]"}
                    placeholder="What to do in this step"
                    required
                    rows="2"
                    aria-label={"Step #{display_idx + 1}"}
                    class="min-h-[72px] w-full resize-y border-0 bg-transparent px-0 py-3 text-base leading-normal text-base-content outline-none placeholder:text-muted focus:ring-0"
                  >{field_value(@form_params, "cooking_steps", row_id, "description")}</textarea>
                </div>
                <input
                  type="hidden"
                  name={"post[cooking_steps][#{row_id}][order]"}
                  value={display_idx}
                />
                <button
                  :if={length(@step_rows) > 1}
                  type="button"
                  class="grid size-11 shrink-0 place-items-center rounded-full text-muted hover:bg-base-300 hover:text-base-content"
                  phx-click="remove-step"
                  phx-value-id={row_id}
                  aria-label={"Remove step #{display_idx + 1}"}
                >
                  <.icon name="hero-x-mark" class="size-5" />
                </button>
              </div>
            </div>
            <div class="mt-2 flex flex-wrap items-center gap-3">
              <.add_row_button phx-click="add-step">Add step</.add_row_button>
            </div>
          </.editor_card>

          <%!-- Tools --%>
          <.editor_card id="editor-tools" title="Tools" aside="Optional">
            <p :if={@tool_rows == []} class="text-[14px] text-muted">
              No tools listed. Add things like a Dutch oven, a whisk or a sheet pan.
            </p>
            <div :if={@tool_rows != []} class="flex flex-wrap gap-2">
              <div
                :for={{row_id, display_idx} <- Enum.with_index(@tool_rows)}
                class="inline-flex min-h-10 max-w-full items-center gap-1 rounded-full bg-base-300 pl-3.5 pr-1 focus-within:ring-2 focus-within:ring-accent"
              >
                <input
                  type="text"
                  name={"post[tools][#{row_id}][name]"}
                  value={field_value(@form_params, "tools", row_id, "name")}
                  placeholder="e.g. cast iron"
                  aria-label={"Tool #{display_idx + 1}"}
                  class="w-32 min-w-0 border-0 bg-transparent p-0 text-[14px] font-semibold text-base-content outline-none placeholder:font-normal placeholder:text-muted focus:ring-0"
                />
                <input type="hidden" name={"post[tools][#{row_id}][order]"} value={display_idx} />
                <button
                  type="button"
                  class="grid size-9 shrink-0 place-items-center rounded-full text-muted hover:text-base-content"
                  phx-click="remove-tool"
                  phx-value-id={row_id}
                  aria-label={"Remove tool #{display_idx + 1}"}
                >
                  <.icon name="hero-x-mark" class="size-4" />
                </button>
              </div>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <.add_row_button phx-click="add-tool">Add tool</.add_row_button>
            </div>
          </.editor_card>
        <% end %>

        <%!-- Tags (both types) --%>
        <.editor_card id="editor-tags" title="Tags" aside="Optional, comma separated">
          <div class="flex min-h-[50px] items-center rounded-[14px] bg-base-200 px-3.5 ring-1 ring-inset ring-hairline-strong focus-within:ring-2 focus-within:ring-accent">
            <input
              type="text"
              name="post[tags_input]"
              value={@form_params["tags_input"]}
              placeholder="pasta, italian, weeknight"
              aria-label="Tags"
              phx-debounce="500"
              class="w-full min-w-0 border-0 bg-transparent p-0 text-base text-base-content outline-none placeholder:text-muted focus:ring-0"
            />
          </div>
        </.editor_card>
      </div>

      <%!-- Preview and post --%>
      <aside
        id="editor-aside"
        aria-label="Preview and post"
        class="flex min-w-0 flex-col gap-3.5 lg:sticky lg:top-24"
      >
        <% title = preview_title(f[:caption].value) %>
        <% time = is_recipe && preview_time(f[:cooking_time_minutes].value) %>
        <% first_entry = List.first(@uploads.photos.entries) %>
        <div
          id="editor-preview"
          class="flex min-w-0 flex-col rounded-[21px] bg-base-100 p-1.5 shadow-card"
        >
          <div class="relative aspect-[4/3] overflow-hidden rounded-[15px] bg-cream-lift">
            <.live_img_preview
              :if={first_entry}
              id={"editor-preview-#{first_entry.ref}"}
              entry={first_entry}
              class="absolute inset-0 size-full object-cover"
            />
            <div :if={!first_entry} class="absolute inset-0 grid place-items-center">
              <.icon name="hero-camera" class="size-7 text-muted" />
            </div>
            <span
              :if={time}
              class="absolute bottom-2 left-2 rounded-full bg-pill px-[9px] py-1 text-xs font-semibold leading-none text-base-content backdrop-blur-[20px]"
            >
              {time}
            </span>
          </div>
          <div class="flex flex-col gap-1.5 px-2 pb-2 pt-2.5">
            <span class={[
              "font-display text-base font-extrabold leading-tight line-clamp-2 break-words",
              title == "" && "text-muted"
            ]}>
              {if title == "",
                do: if(is_recipe, do: "Your recipe name", else: "Your caption"),
                else: title}
            </span>
            <span class="flex min-w-0 items-center gap-1.5 text-[12.5px] text-muted">
              <.user_avatar
                username={@current_scope.user.username}
                photo_url={@current_scope.user.profile_photo_url}
                size="xs"
              />
              <span class="truncate">You, as it shows in feeds</span>
            </span>
          </div>
        </div>

        <div
          :if={is_recipe}
          id="editor-checklist"
          class="rounded-[22px] bg-base-100 p-4 shadow-card md:p-[22px]"
        >
          <ul class="flex flex-col gap-2.5">
            <li
              :for={{label, done} <- editor_checklist(@form_params, @uploads.photos.entries)}
              data-done={to_string(done)}
              class="flex items-center gap-2.5 text-[14.5px]"
            >
              <span
                aria-hidden="true"
                class={[
                  "grid size-[22px] shrink-0 place-items-center rounded-full",
                  if(done,
                    do: "bg-primary text-primary-content",
                    else: "ring-2 ring-inset ring-hairline-strong"
                  )
                ]}
              >
                <.icon :if={done} name="hero-check" class="size-3.5" />
              </span>
              <span>{label}</span>
              <span class="sr-only">{if done, do: "(done)", else: "(to do)"}</span>
            </li>
          </ul>
        </div>

        <%!-- The save errors put in the flash ("Please upload at least one
             photo", "Photo upload failed") and the recipe-only rule. They
             show here, in place, and only here: mount sets :inline_flash to
             [:error], so the live layout's toast group skips them (D127).
             The validate event clears the flash, so the note goes once the
             user edits the form or attaches a photo. --%>
        <.field_note
          id="editor-form-note"
          messages={field_errors(f[:type]) ++ List.wrap(Phoenix.Flash.get(@flash, :error))}
        />

        <div id="editor-publish" class="flex flex-col gap-2.5">
          <.accent_button
            type="submit"
            wide
            phx-disable-with="Posting…"
            class="min-h-[54px] text-[17px]"
          >
            {if is_recipe, do: "Post recipe", else: "Post"}
          </.accent_button>
          <.secondary_button navigate={~p"/feed"} wide>Cancel</.secondary_button>
        </div>
      </aside>
    </.form>
  </main>
<% end %>
