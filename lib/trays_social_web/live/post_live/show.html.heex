<%!-- Recipe page (W248), per the redesign canvas Recipe artboard (web).
     Desktop: photo | head on the first row, ingredients | steps on the
     next, notes and the back link full width below. Narrower than lg it
     follows the iOS single column. A legacy photo post (type "post") shows
     the photo with a Photo tag, the cook, its caption and a short note, and
     no meta, cook's note, ingredients or steps. Servings scaling, step
     timers, the full-screen cook mode and "More from this cook" are not
     built here (spec D16); web keeps its stopwatch. --%>

<% photos =
  if Ecto.assoc_loaded?(@post.post_photos) && !Enum.empty?(@post.post_photos),
    do: Enum.sort_by(@post.post_photos, & &1.position),
    else: [%{url: @post.photo_url}] %>
<% photo_count = length(photos) %>
<% current_photo = Enum.at(photos, @photo_index) %>

<% raw_caption = @post.caption || "" %>
<% title_text = TraysSocialWeb.TrayFormatting.post_title(@post) %>
<% body_text = TraysSocialWeb.TrayFormatting.post_note(@post) %>

<% legacy = @post.type != "recipe" %>
<% viewer = assigns[:current_scope] && @current_scope.user %>
<% owner? = viewer && viewer.id == @post.user_id %>

<% has_ingredients =
  !legacy and Ecto.assoc_loaded?(@post.ingredients) and not Enum.empty?(@post.ingredients) %>
<% has_tools =
  !legacy and Ecto.assoc_loaded?(@post.tools) and not Enum.empty?(@post.tools) %>
<% has_steps =
  !legacy and Ecto.assoc_loaded?(@post.cooking_steps) and not Enum.empty?(@post.cooking_steps) %>
<% has_tags =
  Ecto.assoc_loaded?(@post.post_tags) and not Enum.empty?(@post.post_tags) %>

<article
  id="recipe"
  class="mx-auto grid max-w-[1160px] grid-cols-1 gap-y-8 px-4 pt-6 pb-16 text-base-content md:px-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start lg:gap-x-12 lg:gap-y-10"
>
  <%!-- Photo. Keeps the multi-photo carousel controls. --%>
  <div
    id="recipe-hero"
    class={[
      "relative min-w-0 overflow-hidden rounded-3xl bg-cream-lift",
      if(legacy, do: "aspect-square", else: "aspect-[4/5]")
    ]}
  >
    <img
      id={"show-photo-#{@photo_index}"}
      src={current_photo.url}
      alt={if legacy, do: "Photo", else: "Recipe photo"}
      class="absolute inset-0 size-full object-cover animate-fade-in"
    />

    <span
      :if={legacy}
      id="legacy-photo-label"
      class="absolute left-3 top-3 rounded-full bg-base-100 px-2.5 py-1 text-[11.5px] font-bold leading-none text-base-content shadow-sm"
    >
      Photo
    </span>

    <%= if photo_count > 1 do %>
      <button
        type="button"
        class="absolute left-3 top-1/2 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-pill text-base-content shadow-pill backdrop-blur-[20px] focus-visible:outline-2 focus-visible:outline-primary"
        phx-click="prev-photo"
        aria-label="Previous photo"
      >
        <.icon name="hero-chevron-left" class="size-5" />
      </button>
      <button
        type="button"
        class="absolute right-3 top-1/2 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-pill text-base-content shadow-pill backdrop-blur-[20px] focus-visible:outline-2 focus-visible:outline-primary"
        phx-click="next-photo"
        aria-label="Next photo"
      >
        <.icon name="hero-chevron-right" class="size-5" />
      </button>

      <div class="absolute inset-x-0 bottom-3 flex justify-center gap-1.5" aria-hidden="true">
        <%= for idx <- 0..(photo_count - 1) do %>
          <div class={[
            "size-2 rounded-full transition-all",
            if(idx == @photo_index, do: "scale-125 bg-base-100", else: "bg-base-100/50")
          ]} />
        <% end %>
      </div>

      <div class="absolute right-3 top-3 rounded-full bg-pill px-2.5 py-1 text-xs font-semibold text-base-content backdrop-blur-[20px]">
        {@photo_index + 1} / {photo_count}
      </div>
    <% end %>
  </div>

  <%!-- Head: kicker, title, byline, meta, cook's note, actions. --%>
  <header id="recipe-head" class="min-w-0 lg:pt-2">
    <%= if legacy do %>
      <h1 class="sr-only">Photo post by {@post.user.username}</h1>
    <% else %>
      <p
        :if={has_tags}
        id="recipe-kicker"
        class="mb-1.5 truncate text-[13.5px] font-semibold text-muted"
      >
        {@post.post_tags |> Enum.take(3) |> Enum.map_join(" · ", & &1.tag)}
      </p>
      <h1 class="min-w-0 break-words font-display text-[28px] font-extrabold leading-[1.15] tracking-[-0.02em] lg:text-[42px] lg:leading-[1.1]">
        {title_text}
      </h1>
    <% end %>

    <div id="recipe-byline" class="mt-3.5 flex items-center gap-2.5">
      <.link
        navigate={~p"/@#{@post.user.username}"}
        class="shrink-0"
        aria-hidden="true"
        tabindex="-1"
      >
        <.user_avatar
          username={@post.user.username}
          photo_url={@post.user.profile_photo_url}
          size="md"
        />
      </.link>
      <div class="flex min-w-0 flex-1 flex-col gap-px">
        <.link
          navigate={~p"/@#{@post.user.username}"}
          class="truncate text-[15px] font-bold hover:underline"
        >
          {@post.user.username}
        </.link>
        <span class="truncate text-[13px] text-muted">
          @{@post.user.username} · {Calendar.strftime(@post.inserted_at, "%B %-d, %Y")}
        </span>
      </div>
      <.follow_button
        :if={viewer && !owner?}
        following={@is_following}
        class="shrink-0"
        phx-click="toggle-follow"
      />
    </div>

    <%= if legacy do %>
      <p id="legacy-caption" class="mt-3.5 break-words text-[17px] leading-normal">
        {raw_caption}
      </p>
      <p
        id="legacy-note"
        class="mt-3.5 rounded-[14px] bg-base-300 px-3 py-2.5 text-[13px] leading-snug text-muted"
      >
        A photo post from before Trays had recipes. It can be saved, but has no ingredients or steps.
      </p>
    <% else %>
      <div id="recipe-meta" class="mt-4 flex flex-wrap gap-2">
        <span
          :if={@post.cooking_time_minutes}
          class="inline-flex min-h-[34px] items-center gap-1.5 rounded-full bg-base-300 px-3 text-[13.5px] font-semibold"
        >
          <.icon name="hero-clock" class="size-4 text-muted" />
          {format_cook_time(@post.cooking_time_minutes)}
        </span>
        <span
          :if={@post.servings}
          class="inline-flex min-h-[34px] items-center gap-1.5 rounded-full bg-base-300 px-3 text-[13.5px] font-semibold"
        >
          <.icon name="hero-users" class="size-4 text-muted" /> Serves {@post.servings}
        </span>
        <span
          :if={has_ingredients}
          class="inline-flex min-h-[34px] items-center gap-1.5 rounded-full bg-base-300 px-3 text-[13.5px] font-semibold"
        >
          <.icon name="hero-list-bullet" class="size-4 text-muted" />
          {if length(@post.ingredients) == 1,
            do: "1 ingredient",
            else: "#{length(@post.ingredients)} ingredients"}
        </span>
      </div>

      <div
        :if={body_text != ""}
        id="recipe-note"
        class="mt-[18px] rounded-[20px] bg-cream-lift px-4 py-3.5"
      >
        <p class="text-[12.5px] font-bold text-muted">From {@post.user.username}</p>
        <p class="mt-1 break-words text-[15px] leading-normal">{body_text}</p>
      </div>
    <% end %>

    <div id="recipe-actions" class="mt-[22px] flex flex-wrap items-center gap-3">
      <%= if has_steps do %>
        <% cooking = @cooking_started_at != nil %>
        <.accent_button
          type="button"
          phx-click="toggle-cook-mode"
          aria-pressed={if cooking, do: "true", else: "false"}
        >
          <.icon name={if cooking, do: "hero-stop-circle", else: "hero-fire"} class="size-5" />
          {if cooking, do: "Stop cooking", else: "Start cooking"}
        </.accent_button>
      <% end %>

      <button
        type="button"
        phx-click="toggle-bookmark"
        class={[
          "inline-flex min-h-[50px] items-center justify-center gap-2.5 rounded-full px-[22px] text-[15.5px] font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
          if(@bookmarked,
            do: "bg-mint-tint text-primary-ink",
            else:
              "bg-base-100 text-base-content ring-1 ring-inset ring-hairline-strong hover:bg-base-300"
          )
        ]}
        aria-label={if @bookmarked, do: "Remove from My Tray", else: "Save to My Tray"}
        aria-pressed={if @bookmarked, do: "true", else: "false"}
      >
        <.icon
          name={if @bookmarked, do: "hero-bookmark-solid", else: "hero-bookmark"}
          class="size-5"
        />
        <span>{if @bookmarked, do: "Saved to My Tray", else: "Save to My Tray"}</span>
      </button>

      <button
        type="button"
        phx-click="toggle-like"
        aria-label="Helpful"
        aria-pressed={if @liked, do: "true", else: "false"}
        class={[
          "inline-flex min-h-11 items-center gap-1.5 rounded-full px-4 text-[13.5px] font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-primary",
          if(@liked,
            do: "bg-mint-tint text-primary-ink",
            else: "bg-base-300 text-base-content hover:bg-base-200"
          )
        ]}
      >
        <.icon name={if @liked, do: "hero-heart-solid", else: "hero-heart"} class="size-4" />
        <span>{@post.like_count} helpful</span>
      </button>

      <a
        href="#cooks-notes"
        class="inline-flex min-h-11 items-center gap-1.5 rounded-full bg-base-300 px-4 text-[13.5px] font-semibold text-base-content transition-colors hover:bg-base-200 focus-visible:outline-2 focus-visible:outline-primary"
      >
        <.icon name="hero-chat-bubble-left-ellipsis" class="size-4" />
        <span>{@post.comment_count} notes</span>
      </a>

      <%!-- Owner delete, kept quiet so it never anchors the eye. --%>
      <button
        :if={owner?}
        type="button"
        phx-click="delete"
        data-confirm="Are you sure you want to delete this post?"
        class="inline-flex min-h-11 items-center px-2 text-[13px] text-muted transition-colors hover:text-error"
      >
        Delete
      </button>
    </div>
  </header>

  <%!-- W159 sponsored slot A, between the head and the recipe body. Gated
       per viewer by @show_ads (flag on AND not a subscriber). --%>
  <div :if={@show_ads} class="min-w-0 lg:col-span-2">
    <.sponsored_slot id="ad-slot-a" position="in-content-1" />
  </div>

  <%!-- Ingredients: a tick list on a surface card, sticky on desktop. Each
       row is a button so the whole row is the target. State is
       session-local; nothing persists. --%>
  <section
    :if={has_ingredients}
    id="recipe-ingredients"
    aria-labelledby="recipe-ingredients-heading"
    class="min-w-0 lg:sticky lg:top-24 lg:self-start"
  >
    <h2
      id="recipe-ingredients-heading"
      class="mb-3 font-display text-[20px] font-extrabold leading-tight tracking-[-0.01em] lg:text-[24px]"
    >
      Ingredients
    </h2>
    <ul class="rounded-[22px] bg-base-100 px-[18px] pt-1 pb-1.5 shadow-card">
      <%= for ingredient <- Enum.sort_by(@post.ingredients, & &1.order) do %>
        <% checked = MapSet.member?(@checked_ingredient_ids, ingredient.id) %>
        <li class="border-b border-hairline last:border-b-0">
          <button
            type="button"
            phx-click="toggle-ingredient"
            phx-value-id={ingredient.id}
            aria-pressed={if checked, do: "true", else: "false"}
            class="flex min-h-[54px] w-full items-center gap-3.5 py-3 text-left focus-visible:outline-2 focus-visible:outline-primary"
          >
            <span
              aria-hidden="true"
              class={[
                "grid size-[26px] shrink-0 place-items-center rounded-full transition-colors",
                if(checked,
                  do: "bg-primary text-primary-content",
                  else: "ring-2 ring-inset ring-hairline-strong"
                )
              ]}
            >
              <.icon :if={checked} name="hero-check-mini" class="size-4" />
            </span>
            <span class={[
              "min-w-[68px] shrink-0 text-[15.5px] font-bold tabular-nums",
              checked && "text-muted"
            ]}>
              {[ingredient.quantity, ingredient.unit]
              |> Enum.reject(&(is_nil(&1) or &1 == ""))
              |> Enum.join(" ")}
            </span>
            <span class={[
              "min-w-0 flex-1 break-words text-[15.5px] leading-[1.35]",
              checked && "text-muted line-through"
            ]}>
              {ingredient.name}
            </span>
          </button>
        </li>
      <% end %>
    </ul>
    <p :if={has_tools} id="recipe-tools" class="mt-3 break-words text-[13px] text-muted">
      Tools: {@post.tools |> Enum.sort_by(& &1.order) |> Enum.map_join(", ", & &1.name)}
    </p>
  </section>

  <%!-- Steps: numbered cards. --%>
  <section
    :if={has_steps}
    id="recipe-steps"
    aria-labelledby="recipe-steps-heading"
    class="min-w-0"
  >
    <h2
      id="recipe-steps-heading"
      class="mb-3 font-display text-[20px] font-extrabold leading-tight tracking-[-0.01em] lg:text-[24px]"
    >
      Steps
    </h2>
    <ol class="flex flex-col gap-3">
      <li
        :for={step <- Enum.sort_by(@post.cooking_steps, & &1.order)}
        id={"recipe-step-#{step.id}"}
        class="flex gap-3.5 rounded-[20px] bg-base-100 p-4 shadow-card"
      >
        <span class="grid size-8 shrink-0 place-items-center rounded-full bg-accent/25 font-display text-[15px] font-extrabold">
          {step.order + 1}
        </span>
        <p class="min-w-0 flex-1 break-words pt-1 text-[15px] leading-normal lg:text-[17px]">
          {step.description}
        </p>
      </li>
    </ol>
  </section>

  <div class="min-w-0 space-y-8 lg:col-span-2">
    <%!-- W159 sponsored slot B, after the recipe body. Two units per page
         is the hard density cap (see AdComponents). --%>
    <.sponsored_slot :if={@show_ads} id="ad-slot-b" position="in-content-2" />

    <%!-- Cook's notes, collapsed by default; opening the details reveals
         the thread and the composer. --%>
    <details id="cooks-notes" class="group rounded-3xl bg-base-100 shadow-card">
      <summary class="flex min-h-14 cursor-pointer list-none items-center gap-3 px-5 py-3 [&::-webkit-details-marker]:hidden">
        <.icon name="hero-chat-bubble-left-ellipsis" class="size-5 shrink-0 text-muted" />
        <span class="min-w-0 flex-1 text-[15px] font-semibold">
          <%= cond do %>
            <% @post.comment_count == 0 -> %>
              No notes yet — be the first to leave one
            <% @post.comment_count == 1 -> %>
              1 cook left a note
            <% true -> %>
              {@post.comment_count} cooks left notes
          <% end %>
        </span>
        <span class="shrink-0 text-[14px] font-semibold text-primary-ink">
          <span class="group-open:hidden">Open notes</span>
          <span class="hidden group-open:inline">Close notes</span>
        </span>
      </summary>

      <div class="space-y-5 border-t border-hairline px-5 py-5">
        <div id="comments" phx-update="stream" class="space-y-5">
          <div :for={{dom_id, comment} <- @streams.comments} id={dom_id} class="flex gap-3">
            <.user_avatar
              username={comment.user.username}
              photo_url={comment.user.profile_photo_url}
              size="sm"
              class="shrink-0"
            />
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline justify-between gap-2">
                <div class="flex min-w-0 items-baseline gap-1.5">
                  <span class="truncate text-[14px] font-bold">
                    {comment.user.username}
                  </span>
                  <%= if comment.user_id == @post.user_id do %>
                    <%!-- "Cook" badge on the recipe author's own replies, so
                         readers know it is the cook answering. --%>
                    <span class="inline-flex shrink-0 items-center rounded-full bg-mint-tint px-2 py-0.5 text-[11px] font-bold text-primary-ink">
                      Cook
                    </span>
                  <% end %>
                </div>
                <span class="shrink-0 text-[12px] text-muted">
                  {Calendar.strftime(comment.inserted_at, "%b %-d")}
                </span>
              </div>
              <p class="mt-1 break-words text-[14.5px] leading-relaxed">
                {comment.body}
              </p>
              <%= if viewer && viewer.id == comment.user_id do %>
                <button
                  type="button"
                  class="mt-1 text-[13px] text-muted transition-colors hover:text-error"
                  phx-click="delete-comment"
                  phx-value-id={comment.id}
                  data-confirm="Delete this comment?"
                >
                  Delete
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <%= if viewer do %>
          <.form
            for={%{}}
            as={:comment}
            phx-submit="add-comment"
            class="flex items-center gap-2 border-t border-hairline pt-4"
          >
            <input
              type="text"
              name="comment[body]"
              value={@comment_body}
              placeholder="Leave a note for the cook…"
              aria-label="Leave a note for the cook"
              class="min-h-11 min-w-0 flex-1 rounded-full border-0 bg-base-300 px-4 text-[15px] text-base-content ring-1 ring-inset ring-hairline placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary"
              required
              maxlength="1000"
            />
            <.primary_button type="submit" class="min-h-11 shrink-0">Post</.primary_button>
          </.form>
        <% else %>
          <p class="border-t border-hairline pt-4 text-[14px] text-muted">
            <.link
              navigate={~p"/users/log-in"}
              class="font-semibold text-primary-ink hover:underline"
            >
              Log in
            </.link>
            to leave a note.
          </p>
        <% end %>
      </div>
    </details>

    <.link
      navigate={~p"/feed"}
      class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-muted transition-colors hover:text-base-content"
    >
      <.icon name="hero-arrow-left" class="size-4" /> Back to feed
    </.link>
  </div>
</article>

<%!-- Floating cook-mode stopwatch. The CookTimer JS hook reads
     data-started-at and updates the text every second client-side, so the
     server does not see a tick per second. Sits above the mobile tab bar. --%>
<%= if @cooking_started_at do %>
  <div
    role="status"
    aria-live="polite"
    class="fixed bottom-24 left-1/2 z-40 inline-flex h-12 -translate-x-1/2 items-center gap-3 rounded-full bg-base-100 pr-2 pl-4 shadow-card ring-1 ring-inset ring-primary md:bottom-6"
  >
    <span class="text-[12px] font-bold text-primary-ink">Cooking</span>
    <span
      id="cook-timer-display"
      phx-hook="CookTimer"
      phx-update="ignore"
      data-started-at={DateTime.to_iso8601(@cooking_started_at)}
      class="font-display text-[18px] font-extrabold tabular-nums"
    >
      0:00
    </span>
    <button
      type="button"
      phx-click="toggle-cook-mode"
      class="grid size-8 place-items-center rounded-full bg-base-300 text-muted transition-colors hover:text-base-content"
      aria-label="Stop cooking"
    >
      <.icon name="hero-stop" class="size-3.5" />
    </button>
  </div>
<% end %>
